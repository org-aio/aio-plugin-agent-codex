{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist/native/types"
  },
  "include": [
    "native/**/*.ts",
    "shared/**/*.ts",
    "frontend/**/*.ts"
  ]
}
