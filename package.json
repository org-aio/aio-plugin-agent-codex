{
  "name": "@zjarlin/aio-codex-web",
  "version": "0.1.0",
  "description": "AIO paired-device connector for the original Codex and Codex Buddy web interface",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/native/types/native/index.d.ts",
      "import": "./dist/native/index.mjs"
    }
  },
  "files": [
    "dist/native",
    "README.md"
  ],
  "scripts": {
    "build:native": "node scripts/build-native.mjs && tsc --emitDeclarationOnly",
    "test:native": "npm run build:native && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build:native",
    "prepare": "npm run build:native",
    "test:browser": "node test/browser/sandbox.mjs"
  },
  "dependencies": {
    "@ungap/structured-clone": "1.4.0",
    "chrome-remote-interface": "0.34.0",
    "parse5": "8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/chrome-remote-interface": "0.31.14",
    "@types/node": "22.19.15",
    "@types/ungap__structured-clone": "1.2.0",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "ws": "8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/org-aio/aio-plugin-agent-codex.git"
  }
}
